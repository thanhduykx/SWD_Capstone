@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="hero">
    <p class="eyebrow">Layered MVC Architecture</p>
    <h1>@Model.ApplicationName</h1>
    <p>CPMS.API handles transport concerns. CPMS.Application keeps use cases, CPMS.Domain owns core rules, and CPMS.Infrastructure owns persistence and external adapters.</p>
</section>

<section class="grid">
    <article>
        <span>Database</span>
        <strong>@Model.DatabaseProvider</strong>
    </article>
    <article>
        <span>Architecture</span>
        <strong>@Model.Architecture</strong>
    </article>
</section>
