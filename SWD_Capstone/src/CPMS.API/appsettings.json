{
  "ConnectionStrings": {
    "CpmsDatabase": "",
    "Redis": "",
    "RabbitMQ": ""
  },
  "Jwt": {
    "Issuer": "CPMS.API",
    "Audience": "CPMS.Swagger",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Swagger": {
    "Enabled": true,
    "ExposeTestSupport": false
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromEmail": "",
    "FromName": "CPMS",
    "UserName": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000"
    ]
  },
  "Hangfire": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
